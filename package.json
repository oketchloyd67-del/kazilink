{
  "name": "kazilink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cross-env NODE_ENV=development nodemon --watch server --watch package.json --exec \"node server/index.js\"",
    "dev:client": "vite",
    "build": "cd client && vite build",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "migrate": "node server/migrate.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cross-env": "^7.0.3",
    "dbus-next": "^0.10.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.6.1",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.7",
    "speakeasy": "^2.0.0",
    "uuid": "^14.0.3",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "^8.2.2",
    "nodemon": "^2.0.0",
    "vite": "8.4.0"
  },
  "overrides": {
    "form-data": "4.0.4",
    "request": {
      "form-data": "4.0.4"
    }
  }
}
